{
  "name": "Sonqelra",
  "scopeName": "source.sonqelra",
  "patterns": [
    {
      "name": "comment.line.double-slash.sonqelra",
      "match": "//.*$"
    },
    {
      "name": "string.quoted.double.sonqelra",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.sonqelra",
          "match": "\\\\[\\\\\"nrt]"
        },
        {
          "name": "invalid.illegal.escape.sonqelra",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single.sonqelra",
      "begin": "'",
      "end": "'|$",
      "patterns": [
        {
          "name": "constant.character.escape.sonqelra",
          "match": "\\\\[\\\\\"\\'nrt]"
        },
        {
          "name": "invalid.illegal.escape.sonqelra",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "keyword.control.sonqelra",
      "match": "\\b(?:score|tempo|meter|key|melody|let|fn|return|track|instrument|percussion|play|export|import)\\b"
    },
    {
      "name": "constant.language.boolean.sonqelra",
      "match": "\\b(?:true|false)\\b"
    },
    {
      "name": "storage.type.sonqelra",
      "match": "\\b(?:Pitch|Music|Int|Number|Interval|List)\\b"
    },
    {
      "name": "support.function.sonqelra",
      "match": "\\bmodule\\b(?=\\s*\\()"
    },
    {
      "name": "support.function.sonqelra",
      "match": "\\b(?:note|rest|chord|sequence|transpose|repeat)\\b(?=\\s*\\()"
    },
    {
      "name": "constant.language.music.sonqelra",
      "match": "(?<![A-Za-z_0-9#])[A-G](?:#+|b+)?-?\\d+(?![A-Za-z_0-9#])"
    },
    {
      "name": "constant.numeric.interval.sonqelra",
      "match": "(?<![A-Za-z_0-9])-?\\d+st(?![A-Za-z_0-9])"
    },
    {
      "name": "constant.numeric.sonqelra",
      "match": "(?<![A-Za-z_0-9])-?\\d+(?![A-Za-z_0-9])"
    },
    {
      "name": "keyword.operator.sonqelra",
      "match": "\\|>|->|[+|=/:@<>]"
    }
  ]
}
