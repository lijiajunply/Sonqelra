// 导入乐段模块；模块名取自文件名，引用不会自动添加轨道。
import sonqelra "parts/electric_road.sonqelra"

score "Electric Road" {
    tempo 140
    meter 4/4
    key E minor

    track "Lead Guitar" {
        instrument "Overdriven Guitar"
        play module("electric_road")."Electric Road Parts".track."Lead Guitar"
    }
    track "Rhythm Guitar" {
        instrument "Distortion Guitar"
        play module("electric_road")."Electric Road Parts".track."Rhythm Guitar"
    }
    track "Bass" {
        instrument "Electric Bass (pick)"
        play module("electric_road")."Electric Road Parts".track."Bass"
    }
    track "Drums" {
        instrument "Piano"
        percussion true
        play module("electric_road")."Electric Road Parts".track."Drums"
    }

    export midi "electric_road.mid"
}

// WAV 渲染由外部 FluidSynth 完成，当前 Sonqelra API 不提供该能力：
// fluidsynth -ni -F electric_road.wav -r 44100 \
//   /Users/luckyfish/Documents/music/GeneralUser-GS-main/GeneralUser-GS.sf2 electric_road.mid
