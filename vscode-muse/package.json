{
  "name": "muse-lang",
  "displayName": "Muse Language",
  "description": "Syntax highlighting, completion, navigation and compilation for Muse music files.",
  "version": "0.2.0",
  "publisher": "muse-lang",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:muse"
  ],
  "contributes": {
    "languages": [
      {
        "id": "muse",
        "aliases": [
          "Muse",
          "muse"
        ],
        "extensions": [
          ".muse"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "muse",
        "scopeName": "source.muse",
        "path": "./syntaxes/muse.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "muse.compile",
        "title": "Muse: Compile and Export"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "muse.compile",
          "when": "editorLangId == muse",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "muse.compile",
          "when": "editorLangId == muse",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Muse",
      "properties": {
        "muse.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Python executable with muse_lang installed. An absolute path is recommended for virtual environments."
        }
      }
    },
    "problemMatchers": [
      {
        "name": "muse",
        "owner": "muse",
        "source": "Muse",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      }
    ],
    "snippets": [
      {
        "language": "muse",
        "path": "./snippets/muse.json"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
